# Canonical source hashes must survive a fresh Windows or Linux checkout.
* text=auto eol=lf

# Explicitly enforce pure LF line endings on all source, doc, config, script, and UI text files.
*.rs text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf
*.html text eol=lf
*.css text eol=lf
*.svg text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.txt text eol=lf
*.manifest text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
.editorconfig text eol=lf

# Evidence artifacts bind exact bytes. Keep those paths byte-stable across
# Windows/Linux checkouts; regular source, workflow and manifest files remain
# normal text so Git can normalize CRLF/LF and diff checks stay meaningful.
docs/rebuild/receipts/** -text
docs/rebuild/audit/** -text
docs/rebuild/research/snapshots/** -text
# This manifest is hash-bound by its immutable snapshot bindings.
docs/rebuild/research/KEYWORD_OSS_CYCLE30_20261110.json -text
docs/rebuild/research/KEYWORD_OSS_CYCLE31_20261110.json -text
docs/rebuild/research/KEYWORD_OSS_CYCLE32_20261110.json -text
docs/rebuild/research/KEYWORD_OSS_CYCLE33_20261110.json -text
docs/rebuild/research/KEYWORD_OSS_CYCLE34_20261110.json -text
artifacts/** -text

*.png binary
