# Omnia Full Native Rust (17-crate Cargo workspace) & Flagship Studio — out-of-source builds live in D:\OmniaData\build\.
# Rust / Cargo & Windows SDK build outputs (never emitted in-tree)
target/
build/
out/
*.obj
*.o
*.pdb
*.idb
*.ilk
*.exp
*.lib
*.dll
*.exe
*.rlib
*.rmeta
*.d
*.tlog

# Project-owned reusable skills are tracked; live local agent state is not.
.agents/
!.agents/
.agents/*
!.agents/skills.json
!.agents/skills/
!.agents/skills/**
.claude/

# Python / tooling / transient caches
__pycache__/
*.py[cod]
.pytest_cache/
.cache/
node_modules/
dist/
coverage/

# Runtime databases, logs & local secrets
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.log
.env
.env.*

# Transitional / externalized root names & ACL-locked orphaned directory
Roaming/
repos/
publish-worktree/
archive/
backups/
quarantine/
artifacts/
logs/
tmp/
output/
downloads/

# OS & editor metadata
.vscode/
.idea/
.vs/
Thumbs.db
.DS_Store
